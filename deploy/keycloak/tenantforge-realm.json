{
  "realm": "tenantforge",
  "enabled": true,
  "displayName": "TenantForge",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      { "name": "tenant_admin", "description": "Manages a tenant: invoices, exports, billing" },
      { "name": "tenant_member", "description": "Works inside a tenant" }
    ]
  },
  "groups": [
    {
      "name": "tenants",
      "path": "/tenants",
      "subGroups": [
        { "name": "11111111-1111-1111-1111-111111111111", "path": "/tenants/11111111-1111-1111-1111-111111111111", "attributes": { "slug": ["acme"] } },
        { "name": "22222222-2222-2222-2222-222222222222", "path": "/tenants/22222222-2222-2222-2222-222222222222", "attributes": { "slug": ["zenith"] } },
        { "name": "33333333-3333-3333-3333-333333333333", "path": "/tenants/33333333-3333-3333-3333-333333333333", "attributes": { "slug": ["orbit"] } }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@acme.example",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["tenant_admin"],
      "groups": ["/tenants/11111111-1111-1111-1111-111111111111"]
    },
    {
      "username": "bob",
      "email": "bob@acme.example",
      "firstName": "Bob",
      "lastName": "Member",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["tenant_member"],
      "groups": ["/tenants/11111111-1111-1111-1111-111111111111"]
    },
    {
      "username": "zara",
      "email": "zara@zenith.example",
      "firstName": "Zara",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["tenant_admin"],
      "groups": ["/tenants/22222222-2222-2222-2222-222222222222"]
    },
    {
      "username": "omar",
      "email": "omar@orbit.example",
      "firstName": "Omar",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }],
      "realmRoles": ["tenant_admin"],
      "groups": ["/tenants/33333333-3333-3333-3333-333333333333"]
    }
  ],
  "clients": [
    {
      "clientId": "tenantforge-web",
      "name": "TenantForge dashboard",
      "enabled": true,
      "publicClient": false,
      "secret": "tenantforge-web-dev-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "tenant_id",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "tenantforge-cli",
      "name": "TenantForge CLI (local development only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "claim.name": "tenant_id",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}
