# Copy to .env.local for `npm run dev` outside Docker
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string
KEYCLOAK_CLIENT_ID=tenantforge-web
KEYCLOAK_CLIENT_SECRET=tenantforge-web-dev-secret
# What the browser sees (also the token issuer)
KEYCLOAK_ISSUER=http://localhost:8080/realms/tenantforge
# What the Next.js server uses to reach Keycloak (differs inside Docker)
KEYCLOAK_INTERNAL_URL=http://localhost:8080/realms/tenantforge
API_URL=http://localhost:8081
